MAINTAINER "CLARIN.SI <info@clarin.si>"
NAME "PressMint-AT 0.1 (Austrian historical newspapers)"
INFO "Austrian historical newspaper corpus PressMint-AT, 1863-1921 v0.1"
ENCODING "UTF-8"
LOCALE "de_AT.UTF-8"
DEFAULTLOCALE "de_AT.UTF-8"
LANGUAGE "German"
INFOHREF "https://www.clarin.eu/pressmint"
#INFOHREF "http://hdl.handle.net/11356/2068"
TAGSETDOC "https://universaldependencies.org/guidelines.html"

PATH "/data/manatee-data/pressmint10_at/"

VERTICAL "| zcat /data/vert/PressMint-AT.1.0.vert.gz"

DOCSTRUCTURE text
MAXDETAIL 10000

SUBCORPATTRS "p.quality|text.id|text.year,text.newspaper|text.article|text.date,text.publisher|text.volume|text.issue"
FULLREF "text.article,text.newspaper,text.date,text.publisher,text.volume,text.issue,text.source_url,text.id,p.quality,p.id"
SHORTREF "=text.year,=text.newspaper"

STRUCTURE text {
    ATTRIBUTE id {
      TYPE "UNIQUE"
    }
    ATTRIBUTE lang
    ATTRIBUTE date
    ATTRIBUTE year
    ATTRIBUTE newspaper {
      MULTISEP "÷"
    }
    ATTRIBUTE publisher {
      MULTISEP "÷"
      DEFAULTVALUE "-"
    }
    ATTRIBUTE article {
      MULTISEP "÷"
      DEFAULTVALUE "-"
    }
    ATTRIBUTE volume {
      DEFAULTVALUE "-"
    }
    ATTRIBUTE issue {
      DEFAULTVALUE "-"
    }
    ATTRIBUTE source_url
}

STRUCTURE p {
    ATTRIBUTE id {
      TYPE "UNIQUE"
    }
    ATTRIBUTE lang
    ATTRIBUTE quality
    ATTRIBUTE image
    DISPLAYTAG 0
    DISPLAYBEGIN " ¶ "
}

STRUCTURE s {
    ATTRIBUTE id {
      LABEL "Sentence ID"
      TYPE "UNIQUE"
    }
    DISPLAYTAG 0
}

STRUCTURE name {
    ATTRIBUTE type
    DISPLAYTAG 0
    DISPLAYBEGIN "[%(type):"
    DISPLAYEND "]"
}

STRUCTURE g {
    DISPLAYTAG 0
    DISPLAYBEGIN "_EMPTY_"
}

ATTRIBUTE word
ATTRIBUTE lc {
	LABEL	"word (lowercase)"
	DYNAMIC  utf8lowercase
	DYNLIB   internal
	ARG1     "C"
	FUNTYPE  s
	FROMATTR word
	DYNTYPE  index
	TRANSQUERY	yes
}
ATTRIBUTE norm {
	LABEL "Modernised words"
        MULTIVALUE yes
        MULTISEP "|"
}

ATTRIBUTE lemma {
        MULTIVALUE yes
        MULTISEP "|"
}
ATTRIBUTE lemma_lc {
	DYNAMIC     "utf8lowercase"
	DYNLIB      "internal"
	ARG1        "C"
	FUNTYPE     "s"
	FROMATTR    "lemma"
	DYNTYPE     "freq"
	TRANSQUERY  "yes"
}
ATTRIBUTE pos {
        LABEL   "UD PoS tag"
        MULTIVALUE yes
        MULTISEP "|"
}
ATTRIBUTE feats {
        LABEL   "UD features"
        MULTIVALUE yes
        MULTISEP " "
}
