   <text>
      <body>
         <pb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1" n="0" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1"/>
         <cb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1"/>
         <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb1" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l1"/>
         <p xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.p1">Varšavský gubernátor nebude pro<pc force="weak">-</pc>
            <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb2" break="no" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l2"/>puštěn.</p>
         <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb3" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l3"/>
         <p xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.p2">Zpravodaj »Deutsche Volks<pc force="weak">-</pc>
            <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb4" break="no" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l4"/>blattu« se dovídá, že se Německo <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb5" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l5"/>rozhodlo, nevyhověti žádosti za pro<pc force="weak">-</pc>
            <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb6" break="no" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l6"/>puštění generálního gubernátora var<pc force="weak">-</pc>
            <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb7" break="no" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l7"/>šavského, bar. Korffa. Jak známo, <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb8" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l8"/>bylo jeho propuštění žádáno s odůvod<pc force="weak">-</pc>
            <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb9" break="no" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l9"/>něním, že bar. Korff byl zajat při čin<pc force="weak">-</pc>
            <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb1.cb1.lb10" break="no" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg0.a1.c1.l10"/>nosti v intencích Červeného kříže.</p>
         <gap reason="editorial">
            <desc xml:lang="en">SAMPLING</desc>
         </gap>
         <p xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.p139">i s poštou v každém knihkupectví.<lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb5.cb4.lb7" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg4.a1.c4.l7"/>Ukázkové číslo zašle každému na požádání</p>
         <lb xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.pb5.cb4.lb8" facs="#PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.f.pg4.a1.c4.l8"/>
         <p xml:id="PressMint-CZ_1914-12-31-dda72f90-c894-11de-b208-000d606f5dc6.p140">Administrace HUMORIST. LISTŮ v Praze, Spálená 18</p>
