         <lb xml:id="PressMint-CZ_1861-01-01-b8cf84b6-435d-11dd-b505-00145e5790ea.pb4.cb1.lb56" facs="#PressMint-CZ_1861-01-01-b8cf84b6-435d-11dd-b505-00145e5790ea.f.pg3.a1.c1.l56"/>
         <p xml:id="PressMint-CZ_1861-01-01-b8cf84b6-435d-11dd-b505-00145e5790ea.p97">Jindřich Fügner,<lb xml:id="PressMint-CZ_1861-01-01-b8cf84b6-435d-11dd-b505-00145e5790ea.pb4.cb1.lb57" facs="#PressMint-CZ_1861-01-01-b8cf84b6-435d-11dd-b505-00145e5790ea.f.pg3.a1.c1.l57"/>Ústřední Jednatel. <lb xml:id="PressMint-CZ_1861-01-01-b8cf84b6-435d-11dd-b505-00145e5790ea.pb4.cb1.lb58" facs="#PressMint-CZ_1861-01-01-b8cf84b6-435d-11dd-b505-00145e5790ea.f.pg3.a1.c1.l58"/>Úřadování v Lánnově domě č. 1830-31-II bliže nádraží.</p>
