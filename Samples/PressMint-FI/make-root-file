def main(args):
    here = Path('.').resolve()
    root = here.name.replace('.TEI', '')
    if root not in ('PressMint-FI.ana', 'PressMint-FI'):
        raise ValueError('unexpected working directory')
    with open(f'{root}.tmp', mode = ('w' if args.force else 'x')) as ous:
        print('<teiCorpus xmlns="http://www.tei-c.org/ns/1.0">',
              file = ous)
        print(teiHeader,
              file = ous)
        for component in sorted(Path('.').glob('*.xml')):
            if component == Path(f'{root}.xml'): continue
            print(XINCLUDE.format(component),
                  file = ous)
        else:
            # assume all four-character files are four-digit directories
            # that contain a year of input components
            for year in sorted(Path('.').glob('????')):
                for component in sorted(Path(year).glob('*.xml')):
                    print(XINCLUDE.format(component),
                          file = ous)
        print('</teiCorpus>',
              file = ous)
    os.rename(f'{root}.tmp', f'{root}.xml')

if __name__ == '__main__':
    main(parser().parse_args())
