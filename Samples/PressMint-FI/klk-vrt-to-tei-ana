                        '<TEI xmlns="http://www.tei-c.org/ns/1.0"',
                        '     xml:lang="fi"', # overriden in <s>
                        f'     xml:id="{t_id}.ana">'))

        # these are needed for the facsimile link below
        # (page number may go to a text title, too)
        publ_type = t_attributes['publ_type']
        binding_id = t_attributes['binding_id']
        page_no = t_attributes['page_no']

        # {teiHeader}
        content.append(teiHeader.format(
            # Now naming just PressMint-FI, not subcorpus?
            # but might still decide to use these for something?
            # FI_CORPUS = CORPUS['fi', args.corpus],
            # EN_CORPUS = CORPUS['en', args.corpus],
            title = t_attributes['publ_title'], # or issue_title?
            date = t_date,
            page = page_no,
            publ_id = t_attributes['publ_id'], # issn or a substitute?
            oai_identifier = f'oai:digi.kansalliskirjasto.fi:{binding_id}',
            get_record = (
                'https://digi.kansalliskirjasto.fi/interfaces/OAI-PMH'
                '?verb=GetRecord&amp;metadataPrefix=qdc_finna'
                f'&amp;identifier=oai:digi.kansalliskirjasto.fi:{binding_id}'
            )
        ))

        # {facsimile}
        content.append(facsimile.format(
            surface_id = f'{t_id}.facs',
            IMG_URL = f'http://digi.kansalliskirjasto.fi/{publ_type}/binding/{binding_id}?page={page_no}'
        ))

        content.append('<text>')
        content.append('<body>')
        # TODO? fill <pb> and put it in content?
        # TODO? there might be more of them?

        p_counter = count(start = 1)
        for p_attributes, p_body in each('<paragraph',
                                         '</paragraph>',
                                         t_body):
            pnum = next(p_counter)
            p_id = f'{t_id}.p{pnum}'
            content.append(f'<p xml:id="{p_id}">')

            s_counter = count(start = 1)
            for s_attributes, s_body in each('<sentence',
                                             '</sentence>',
                                             p_body):
                snum = next(s_counter)
                s_id = f'{p_id}.s{snum}'
                # map a selection of three-letter codes to two-letter
                # codes for xml:lang, leave the rest as they are from
                # HeLI-OTS (extend mapping as more languages appear)
                lang = s_attributes['lang']
                lang = xmllangcode.get(lang) or lang
                content.append(f'<s xml:id="{s_id}" xml:lang="{lang}">')
                content.extend(sentence(s_attributes, s_body,
                                        self_id = s_id,
                                        fieldnames = names,
                                        args = args))
                content.append('</s>')
            content.append('</p>')

        content.append('</body>')
        content.append('</text>')
        content.append('</TEI>')

        ship('\n'.join(content), t_year, t_id)
        content = []

    return

