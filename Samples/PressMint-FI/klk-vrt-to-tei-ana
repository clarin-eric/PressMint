                    if line.startswith('<!-- #vrt positional-attributes:'))
    # should have crashed if nameline was not found;
    # trust nameline to have the expected format
    names = nameline.rstrip().split()[3:-1]

    content = []
    for t_attributes, t_body in each('<text',
                                     '</text>',
                                     chain(head, ins)):

        t_date = (
            # original sv source sample had no date in a text? that
