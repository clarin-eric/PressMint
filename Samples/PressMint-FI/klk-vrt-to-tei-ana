def eachattribute(line):
    # trust attribute line to have strict syntax:
    # each name="value" without spurious spacing,
    # no equals sign in name, no other doublequotes
    for mo in re.finditer(r'(\S+?)="(.*?)"', line):
        yield mo.groups()

def each(begin, end, ins):
    def isin(line):
        return not line.startswith(end)
    for line in ins:
        if line.startswith(begin):
            attributes = dict(eachattribute(line))
            yield attributes, takewhile(isin, ins)

def sentence(attributes, ins, *, self_id, fieldnames, args):
    # hm. may need t_attributes here? no?
    tokens = [
        dict(zip(fieldnames, line.rstrip('\r\n').split('\t')))
        for line in ins
    ]

    esc = str.maketrans({
        '"' : '&quot;'
    })

    def t_id(token):
        return f"{self_id}.w{token['ref']}"
    def t_word(token):
        return token['word'] # < > & are already escaped
    def t_lemma(token):
        return token['lemma'] # " is not escaped yet!
    def t_pos(token):
        return token['pos'] # hm do both fi and sv have pos?
    def t_msd(token):
        return token['msd'] # TODO something?
    def t_rel(token):
        return token['deprel'] # TODO something?

    for token in tokens:
        el = 'pc' if token['pos'] == 'Punct' else 'w'
        yield f'<{el} xml:id="{t_id(token)}"'
        yield f'   lemma="{t_lemma(token).translate(esc)}"'
        yield f'   pos="{t_pos(token)}"'
        yield f'   msd="{t_msd(token)}"'
        yield f'   ana="[TODO what is this]">{t_word(token)}</{el}>'

    syntax = args.syntax
    yield f'<linkGrp targFunc="head argument" type="{syntax}">'
    for token in tokens:
        head = token['dephead']
        target = f'#{self_id}' if head == '0' else f'#{self_id}.w{head}'
        yield f'<link ana="{syntax}:{t_rel(token)}"'
        yield f'      target="{target} #{t_id(token)}"/>'
    yield f'</linkGrp>'

def fallback_date(t_attributes):
    '''Needed as a dirname so return _something_.'''
    # presumably Swedish sample was just too preliminary but perhaps
    # it still has the datefrom attribute that Korp expects

    yyyymmdd = t_attributes['datefrom']
    if len(yyyymmdd) == 8:
        return f'{yyyymmdd[:4]}-{yyyymmdd[4:6]}-{yyyymmdd[6:]}'
    return '9999-01-01'

def ship(xml, t_year, t_id):
    '''Save content in year/t_id.ana.xml'''
    Path(t_year).mkdir(exist_ok = True)
    out = f'{t_year}/{t_id}.ana.xml'
    tmp = f'{t_year}/{t_id}.ana.xml.tmp'
    with open(tmp, mode = 'x') as ous:
        print(xml, file = ous)
    Path(tmp).rename(out)

def main(args):
